---
import type { Locale } from '../i18n';
import { localizedPath, useCopy } from '../i18n';

type Props = { locale: Locale };
const { locale } = Astro.props;
const t = useCopy(locale);
---
<section class="contact-banner container">
  <div>
    <p class="eyebrow">{t.bannerEyebrow}</p>
    <h2>{t.bannerBefore}<br /><em>{t.bannerEm}</em></h2>
    <p class="muted">{t.bannerBody}</p>
  </div>
  <a class="contact-orb" href={localizedPath(locale, '/contact')} aria-label={t.bannerAria}>
    <span aria-hidden="true">↗</span><span>{t.bannerOrb}</span>
  </a>
</section>
