---
import Layout from '../layouts/Layout.astro';
import Dungeon from '../components/Dungeon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactBanner from '../components/ContactBanner.astro';
import { featuredProjects } from '../content/projects';
---
<Layout title="Home" pathname="/">
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot"></span> GAME DEVELOPER & CREATIVE CODER</p>
      <h1 id="hero-title">Small ideas.<br />Playable<br /><em>worlds.</em><span class="hero-spark" aria-hidden="true">✳</span></h1>
      <div class="hero-intro"><span class="intro-line" aria-hidden="true"></span><div><p class="intro-name">こんにちは、<strong>Kota Ito</strong> です。</p><p>コードから、心が動く体験を。<br />ゲームとグラフィックスの世界を探求しています。</p></div></div>
      <div class="hero-actions"><a class="button button-primary" href="#works">作品を探索する <span aria-hidden="true">↗</span></a><a class="text-link" href="/about">About me <span aria-hidden="true">↗</span></a></div>
      <div class="hero-footnote mono"><span>BASED IN JAPAN</span><span>好奇心、実装中。</span></div>
    </div>
    <Dungeon />
  </section>
  <div class="skill-strip" aria-label="主な技術"><div class="container"><span class="mono">MY TOOLKIT</span><span>Unity</span><i>✳</i><span>Unreal Engine</span><i>✳</i><span>C++ / C#</span><i>✳</i><span>OpenGL</span><i>✳</i><span>Vulkan</span></div></div>
  <section class="works-section container" id="works" aria-labelledby="works-title">
    <div class="section-heading"><div><p class="eyebrow">01 / SELECTED WORKS</p><h2 id="works-title">Made to be <em>played.</em></h2></div><a class="text-link" href="/projects">すべての作品 <span class="count">08</span> ↗</a></div>
    <div class="featured-grid">{featuredProjects.map((project, index) => <ProjectCard project={project} index={index} compact />)}</div>
  </section>
  <section class="about-teaser container" aria-labelledby="about-title"><div><p class="eyebrow">02 / THE DEVELOPER</p><h2 id="about-title">A little logic.<br />A lot of <em>curiosity.</em></h2></div><div class="about-teaser-body"><p class="large-copy">「どう動くんだろう？」<br />から、つくりはじめる。</p><p class="muted">UnityやUnreal Engineでのゲーム開発から、C++による描画の仕組みまで。アルゴリズムを、触って楽しめる体験に変えることが好きです。</p><a class="text-link" href="/about">つくっている人について ↗</a></div></section>
  <ContactBanner />
</Layout>
