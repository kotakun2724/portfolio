---
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Kota Ito ホーム"><span class="brand-symbol" aria-hidden="true"><i></i><i></i><i></i><i></i></span>KOTA ITO<span class="brand-dot">.</span></a>
    <nav aria-label="メインナビゲーション">
      <a href="/projects" aria-current={path.startsWith('/projects') ? 'page' : undefined}><span class="nav-number">01</span> Works</a>
      <a href="/about" aria-current={path.startsWith('/about') ? 'page' : undefined}><span class="nav-number">02</span> About</a>
      <a class="nav-contact" href="/contact" aria-current={path.startsWith('/contact') ? 'page' : undefined}>Let’s talk <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>
