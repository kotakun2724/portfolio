---
import type { Project } from '../content/projects';
type Props = { project: Project; index?: number; compact?: boolean };
const { project, index = 0, compact = false } = Astro.props;
const category = project.stack.includes('Vulkan') || project.stack.includes('OpenGL') ? 'graphics' : 'game';
const image = project.image;
---
<article class:list={['project-card', { 'project-compact': compact }]} id={project.slug} data-category={category}>
  <a class:list={['project-visual', `visual-${project.slug}`]} href={project.links[0].href} target="_blank" rel="noreferrer" aria-label={`${project.name} を${project.links[0].label}で見る（新しいタブ）`}>
    {image ? <img src={image} alt={`${project.name} のゲーム画面`} loading="lazy" width="960" height="540" /> :
      <div class="project-art" aria-hidden="true">
        {category === 'graphics' ? <svg viewBox="0 0 600 340" fill="none"><defs><pattern id={`grid-${project.slug}`} width="30" height="24" patternUnits="userSpaceOnUse"><path d="M30 0H0V24" stroke="currentColor" stroke-width=".7" /></pattern></defs><path d="M0 250 60 220 120 245 180 130 240 165 300 60 360 130 420 115 480 210 540 190 600 240V340H0Z" fill={`url(#grid-${project.slug})`} stroke="currentColor"/><path d="m0 300 180-90 120-110 120 85 180 115M0 330l180-60 120-110 120 85 180 85M60 340l120-130M180 340V130M300 340V60M420 340V115M540 340l-120-225" stroke="currentColor" stroke-opacity=".5"/></svg> : <div class={`game-art game-art-${project.slug}`}><i></i><b></b><i></i></div>}
        <span>{category === 'graphics' ? 'RENDERING EXPERIMENT' : 'GAMEPLAY EXPERIMENT'}</span>
      </div>}
    <span class="project-index mono">{String(index + 1).padStart(2, '0')} / {category === 'graphics' ? 'GRAPHICS' : 'GAME'}</span>
    <span class="project-arrow" aria-hidden="true">↗</span>
  </a>
  <div class="project-info">
    <div class="project-meta mono"><span>{project.role}</span><span>{project.stack.slice(0, 2).join(' / ')}</span></div>
    <h3><a href={project.links[0].href} target="_blank" rel="noreferrer">{project.name}<span aria-hidden="true"> ↗</span></a></h3>
    <p>{project.summary}</p>
    {!compact && <details><summary>開発のポイント <span aria-hidden="true">＋</span></summary><ul>{project.highlights.map(item => <li>{item}</li>)}</ul><div class="tags">{project.stack.map(item => <span>{item}</span>)}</div></details>}
    <div class="project-links">{project.links.map(link => <a href={link.href} target="_blank" rel="noreferrer">{link.label === 'Steam' ? 'Steamで見る' : 'ソースコードを見る'} <span aria-hidden="true">↗</span></a>)}</div>
  </div>
</article>
