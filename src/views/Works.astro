---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactBanner from '../components/ContactBanner.astro';
import { getProjects, projectCategory } from '../content/projects';
import type { Locale } from '../i18n';
import { useCopy } from '../i18n';

type Props = { locale: Locale };
const { locale } = Astro.props;
const t = useCopy(locale);
const projects = getProjects(locale);
const games = projects.filter((project) => projectCategory(project) === 'game').length;
const graphics = projects.length - games;
const count = (value: number) => t.countLabel.replace('{n}', String(value));
---
<Layout title={t.worksTitle} description={t.worksDescription} pathname="/projects" locale={locale}>
  <div class="container">
    <section class="page-hero">
      <p class="eyebrow">{t.archiveEyebrow}</p>
      <h1>{t.archiveLine1}<br /><em>{t.archiveLine2}</em></h1>
      <p class="muted">{t.archiveBody}</p>
    </section>
    <div class="archive-toolbar">
      <div class="filters" role="group" aria-label={t.filterAria}>
        <button data-filter="all" aria-pressed="true">{t.filterAll} <span>{String(projects.length).padStart(2, '0')}</span></button>
        <button data-filter="game" aria-pressed="false">{t.filterGames} <span>{String(games).padStart(2, '0')}</span></button>
        <button data-filter="graphics" aria-pressed="false">{t.filterGraphics} <span>{String(graphics).padStart(2, '0')}</span></button>
      </div>
      <p class="mono" data-filter-status data-count-template={t.countLabel} role="status" aria-live="polite">{count(projects.length)}</p>
    </div>
    <div class="archive-grid">
      {projects.map((project, index) => <ProjectCard project={project} locale={locale} index={index} />)}
    </div>
  </div>
  <ContactBanner locale={locale} />
</Layout>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-category]');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');
  buttons.forEach((button) => button.addEventListener('click', () => {
    buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
    let visible = 0;
    cards.forEach((card) => {
      card.hidden = button.dataset.filter !== 'all' && card.dataset.category !== button.dataset.filter;
      if (!card.hidden) visible++;
    });
    if (status) status.textContent = (status.dataset.countTemplate ?? '{n}').replace('{n}', String(visible));
  }));
</script>
