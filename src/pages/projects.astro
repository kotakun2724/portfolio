---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactBanner from '../components/ContactBanner.astro';
import { projects } from '../content/projects';
---
<Layout title="Works" description="Kota Ito のゲーム作品とグラフィックス実験。Unity、C++、Vulkanでつくった遊べる世界。" pathname="/projects">
  <div class="container">
    <section class="page-hero"><p class="eyebrow">01 / PROJECT ARCHIVE</p><h1>Things I’ve<br /><em>brought to life.</em></h1><p class="muted">ゲーム、グラフィックス、そして実験。つくってきた世界の記録。</p></section>
    <div class="archive-toolbar"><div class="filters" role="group" aria-label="作品のカテゴリ"><button data-filter="all" aria-pressed="true">All works <span>08</span></button><button data-filter="game" aria-pressed="false">Games <span>06</span></button><button data-filter="graphics" aria-pressed="false">Graphics <span>02</span></button></div><p class="mono" data-filter-status role="status" aria-live="polite">8 PROJECTS</p></div>
    <div class="archive-grid">{projects.map((project, index) => <ProjectCard project={project} index={index} />)}</div>
  </div>
  <ContactBanner />
</Layout>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-category]');
  const status = document.querySelector('[data-filter-status]');
  buttons.forEach(button => button.addEventListener('click', () => {
    buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
    let count = 0;
    cards.forEach(card => { card.hidden = button.dataset.filter !== 'all' && card.dataset.category !== button.dataset.filter; if (!card.hidden) count++; });
    if (status) status.textContent = `${count} PROJECTS`;
  }));
</script>
