---
import type { Locale } from '../i18n';
import { useCopy } from '../i18n';
import { localizeHref, projectCategory, type Project } from '../content/projects';

type Props = { project: Project; locale: Locale; index?: number; compact?: boolean };
const { project, locale, index = 0, compact = false } = Astro.props;
const t = useCopy(locale);
const category = projectCategory(project);
const image = project.image;
const href = localizeHref(project.links[0].href, locale);
const visualLabel =
  locale === 'ja'
    ? `${project.name} を${project.links[0].label}${t.cardViewOn}`
    : `View ${project.name} ${t.cardViewOn} ${project.links[0].label} (opens in a new tab)`;
---
<article class:list={['project-card', { 'project-compact': compact }]} id={project.slug} data-category={category}>
  <a class:list={['project-visual', `visual-${project.slug}`]} href={href} target="_blank" rel="noreferrer" aria-label={visualLabel}>
    {image ? (
      <img
        src={image}
        alt={locale === 'ja' ? `${project.name} ${t.cardShot}` : `${project.name} ${t.cardShot}`}
        loading="lazy"
        width="960"
        height="540"
      />
    ) : (
      <div class="project-art" aria-hidden="true">
        {category === 'graphics' ? (
          <svg viewBox="0 0 600 340" fill="none">
            <defs>
              <pattern id={`grid-${project.slug}`} width="30" height="24" patternUnits="userSpaceOnUse">
                <path d="M30 0H0V24" stroke="currentColor" stroke-width=".7" />
              </pattern>
            </defs>
            <path d="M0 250 60 220 120 245 180 130 240 165 300 60 360 130 420 115 480 210 540 190 600 240V340H0Z" fill={`url(#grid-${project.slug})`} stroke="currentColor" />
            <path d="m0 300 180-90 120-110 120 85 180 115M0 330l180-60 120-110 120 85 180 85M60 340l120-130M180 340V130M300 340V60M420 340V115M540 340l-120-225" stroke="currentColor" stroke-opacity=".5" />
          </svg>
        ) : (
          <div class={`game-art game-art-${project.slug}`}><i></i><b></b><i></i></div>
        )}
        <span>{category === 'graphics' ? t.cardRendering : t.cardGameplay}</span>
      </div>
    )}
    <span class="project-index mono">{String(index + 1).padStart(2, '0')} / {category === 'graphics' ? t.cardGraphics : t.cardGame}</span>
    <span class="project-arrow" aria-hidden="true">↗</span>
  </a>
  <div class="project-info">
    <div class="project-meta mono"><span>{project.role}</span><span>{project.stack.slice(0, 2).join(' / ')}</span></div>
    <h3><a href={href} target="_blank" rel="noreferrer">{project.name}<span aria-hidden="true"> ↗</span></a></h3>
    <p>{project.summary}</p>
    {!compact && (
      <details>
        <summary>{t.cardNotes} <span aria-hidden="true">＋</span></summary>
        <ul>{project.highlights.map((item) => <li>{item}</li>)}</ul>
        <div class="tags">{project.stack.map((item) => <span>{item}</span>)}</div>
      </details>
    )}
    <div class="project-links">
      {project.links.map((link) => (
        <a href={localizeHref(link.href, locale)} target="_blank" rel="noreferrer">
          {link.label === 'Steam' ? t.cardSteam : t.cardSource} <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </div>
</article>
