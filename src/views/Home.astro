---
import Layout from '../layouts/Layout.astro';
import Dungeon from '../components/Dungeon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactBanner from '../components/ContactBanner.astro';
import { getProjects } from '../content/projects';
import type { Locale } from '../i18n';
import { localizedPath, useCopy } from '../i18n';

type Props = { locale: Locale };
const { locale } = Astro.props;
const t = useCopy(locale);
const projects = getProjects(locale);
const featured = projects.filter((project) => project.featured);
---
<Layout title={t.homeTitle} description={t.homeDescription} pathname="/" locale={locale}>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot"></span> {t.heroEyebrow}</p>
      <h1 id="hero-title">
        {t.heroLine1}<br />
        {t.heroLine2}<br />
        <em>{t.heroLine3}</em><span class="hero-spark" aria-hidden="true">✳</span>
      </h1>
      <div class="hero-intro">
        <span class="intro-line" aria-hidden="true"></span>
        <div>
          <p class="intro-name">{t.greetingBefore}<strong>Kota Ito</strong>{t.greetingAfter}</p>
          <p>{t.intro.map((line, index) => <>{index > 0 && <br />}{line}</>)}</p>
        </div>
      </div>
      <div class="hero-actions">
        <a class="button button-primary" href="#works">{t.exploreWorks} <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={localizedPath(locale, '/about')}>{t.aboutMe} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="hero-footnote mono"><span>{t.basedIn}</span><span>{t.curiosity}</span></div>
    </div>
    <Dungeon locale={locale} />
  </section>
  <div class="skill-strip" aria-label={t.toolkitAria}>
    <div class="container">
      <span class="mono">{t.toolkitLabel}</span><span>Unity</span><i>✳</i><span>Unreal Engine</span><i>✳</i><span>C++ / C#</span><i>✳</i><span>OpenGL</span><i>✳</i><span>Vulkan</span>
    </div>
  </div>
  <section class="works-section container" id="works" aria-labelledby="works-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{t.selectedEyebrow}</p>
        <h2 id="works-title">{t.selectedBefore}<em>{t.selectedEm}</em></h2>
      </div>
      <a class="text-link" href={localizedPath(locale, '/projects')}>
        {t.allWorks} <span class="count">{String(projects.length).padStart(2, '0')}</span> ↗
      </a>
    </div>
    <div class="featured-grid">
      {featured.map((project, index) => <ProjectCard project={project} locale={locale} index={index} compact />)}
    </div>
  </section>
  <section class="about-teaser container" aria-labelledby="about-title">
    <div>
      <p class="eyebrow">{t.teaserEyebrow}</p>
      <h2 id="about-title">{t.teaserBefore}<br />{t.teaserMid}<em>{t.teaserEm}</em></h2>
    </div>
    <div class="about-teaser-body">
      <p class="large-copy">{t.teaserLarge.map((line, index) => <>{index > 0 && <br />}{line}</>)}</p>
      <p class="muted">{t.teaserBody}</p>
      <a class="text-link" href={localizedPath(locale, '/about')}>{t.teaserLink} ↗</a>
    </div>
  </section>
  <ContactBanner locale={locale} />
</Layout>
