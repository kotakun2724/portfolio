---
import type { Locale } from '../i18n';
import { useCopy } from '../i18n';

type Props = { locale: Locale };
const { locale } = Astro.props;
const t = useCopy(locale);
---
<div
  class="world"
  data-world
  data-static-world={t.staticWorld}
  data-fallback-help={t.fallbackHelp}
  data-interrupted-help={t.interruptedHelp}
  data-canvas-label={t.canvasLabel}
  data-pause-label={t.pauseLabel}
  data-resume-label={t.resumeLabel}
  data-portal-status={t.portalStatus}
  data-thanks-help={t.thanksHelp}
  data-quest-template={t.questTemplate}
  data-help-text={t.helpText}
>
  <div class="world-topline"><span><i class="status-dot"></i> LITTLE WORLD / 001</span><span class="world-live">INTERACTIVE 3D</span></div>
  <div class="world-stage" id="world-stage">
    <div class="world-fallback" aria-hidden="true"><div class="fallback-island"><div class="fallback-gate">✧</div><i></i><i></i><i></i></div></div>
    <div class="world-canvas" data-scene-host></div>
    <div class="crystal-labels" data-crystal-labels hidden>
      {[1, 2, 3].map((n) => (
        <button class="crystal-hit" data-crystal={n - 1} aria-label={t.crystalLabel.replace('{n}', String(n))}>
          <span>✦</span>
        </button>
      ))}
    </div>
    <div class="world-axis" aria-hidden="true"><span>Y</span><i></i><span>X</span></div>
    <div class="world-caption"><span class="mono">{t.worldCaption}</span><p>{t.worldBody}</p></div>
  </div>
  <div class="world-hud">
    <div><span class="hud-label">SIDE QUEST</span><p data-quest-status role="status" aria-live="polite">{t.questTemplate.replace('{n}', '0')}</p></div>
    <button class="icon-button" data-scene-reset aria-label={t.resetLabel} title={t.resetTitle} disabled>↻</button>
    <button class="icon-button" data-scene-pause aria-label={t.pauseLabel} aria-pressed="false" title={t.pauseLabel} disabled>Ⅱ</button>
  </div>
  <p class="world-help" data-scene-help>{t.helpText}</p>
  <noscript><p class="world-help">{t.noscript}</p></noscript>
</div>
<script>
  const world = document.querySelector<HTMLElement>('[data-world]');
  if (world) {
    const load = async () => {
      try {
        const { initDungeon } = await import('../scripts/dungeon');
        initDungeon(world);
      } catch (error) {
        console.warn('Dungeon initialization failed:', error);
        world.dataset.state = 'fallback';
        const help = world.querySelector('[data-scene-help]');
        const status = world.querySelector('[data-quest-status]');
        if (help) help.textContent = world.dataset.fallbackHelp ?? '';
        if (status) status.textContent = world.dataset.staticWorld ?? '';
      }
    };
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => {
        if (entries.some(entry => entry.isIntersecting)) { observer.disconnect(); void load(); }
      }, { rootMargin: '200px' });
      observer.observe(world);
    } else void load();
  }
</script>
